{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "..",
    "outDir": "dist",
    "types": [
      "node"
    ],
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "fflate": ["node_modules/fflate/esm/index.d.mts"],
      "@deepseek-ai/*": [
        "node_modules/@deepseek-ai/*/lib/types/index.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "../plugins/**/*.ts"
  ]
}
