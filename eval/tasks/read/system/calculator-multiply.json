{
  "id": "calculator-multiply",
  "goal": "用手机自带的计算器算 123×456,告诉我结果",
  "apps": [
    "{app:calculator}"
  ],
  "category": "read",
  "partition": "holdout",
  "requires": [
    "app:calculator"
  ],
  "expect": "succeeded",
  "checks": [
    {
      "type": "answer_regex",
      "pattern": "56,?088"
    },
    {
      "type": "answer_grounded",
      "minItems": 1
    }
  ],
  "maxSteps": 20,
  "timeoutSec": 420,
  "note": "手机自带的 App 不钉包名,跑的时候按安卓标准 Intent 找这台手机上的",
  "variants": [
    {
      "goal": "打开手机自带的计算器,算一下 123×456 是多少"
    },
    {
      "goal": "用手机自带的计算器算 321×654,告诉我结果",
      "checks": [
        {
          "type": "answer_regex",
          "pattern": "209,?934"
        },
        {
          "type": "answer_grounded",
          "minItems": 1
        }
      ]
    }
  ]
}
