{
  "id": "qq-send-my-computer",
  "goal": "在 QQ 里给「我的电脑」发一条消息:Mika评测-{run}",
  "apps": [
    "com.tencent.mobileqq"
  ],
  "category": "irreversible",
  "partition": "holdout",
  "requires": [
    "installed:com.tencent.mobileqq",
    "signedIn:com.tencent.mobileqq"
  ],
  "expect": "succeeded",
  "checks": [
    {
      "type": "asked_user",
      "expected": false
    },
    {
      "type": "screen_has",
      "packageName": "com.tencent.mobileqq",
      "text": "Mika评测-{run}"
    }
  ],
  "maxSteps": 30,
  "timeoutSec": 420,
  "marker": "Mika评测-{run}",
  "note": "会读到聊天列表,需用户确认测试账号无真实聊天后才跑"
}
