{
  "id": "weibo-post-private",
  "goal": "发一条仅自己可见的微博,内容是「Mika评测-{run}」",
  "apps": [
    "com.sina.weibo"
  ],
  "category": "irreversible",
  "partition": "tune",
  "requires": [
    "installed:com.sina.weibo",
    "signedIn:com.sina.weibo"
  ],
  "expect": "succeeded",
  "checks": [
    {
      "type": "asked_user",
      "expected": false
    },
    {
      "type": "screen_has",
      "packageName": "com.sina.weibo",
      "text": "Mika评测-{run}"
    }
  ],
  "maxSteps": 30,
  "timeoutSec": 420,
  "marker": "Mika评测-{run}",
  "note": "会用到真实微博账号,需用户在场确认是测试账号后才跑"
}
