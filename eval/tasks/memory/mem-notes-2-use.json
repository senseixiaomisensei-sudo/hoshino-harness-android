    {
      "type": "memory_used",
      "min": 1
    }
  ],
  "maxSteps": 30,
  "timeoutSec": 420,
  "marker": "Mika评测-{run}-月报",
  "note": "手机自带的 App 不钉包名,跑的时候按安卓标准 Intent 找这台手机上的;第二题的目标里故意不写前缀,要靠记忆补上",
  "session": "mem-notes"
}