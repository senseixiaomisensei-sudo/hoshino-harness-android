{
  "id": "alarm-workday",
  "goal": "在手机自带的时钟里新建一个工作日 6:40 响的闹钟,闹钟名称写「Mika评测-{run}-工作日」",
  "apps": [
    "{app:alarm}"
  ],
  "category": "write",
  "partition": "tune",
  "requires": [
    "app:alarm"
  ],
  "expect": "succeeded",
  "checks": [
    {
      "type": "screen_has",
      "packageName": "{app:alarm}",
      "text": "Mika评测-{run}-工作日"
    }
  ],
  "maxSteps": 30,
  "timeoutSec": 420,
  "marker": "Mika评测-{run}-工作日",
  "note": "手机自带的 App 不钉包名,跑的时候按安卓标准 Intent 找这台手机上的"
}
