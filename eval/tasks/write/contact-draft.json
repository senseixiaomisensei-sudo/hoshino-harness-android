{
  "id": "contact-draft",
  "goal": "在手机自带的联系人里新建一个联系人,名字写「Mika评测-{run}-联系人」,电话等其他项都不填,保存",
  "apps": [
    "{app:contacts}"
  ],
  "category": "write",
  "partition": "holdout",
  "requires": [
    "app:contacts"
  ],
  "expect": "succeeded",
  "checks": [
    {
      "type": "screen_has",
      "packageName": "{app:contacts}",
      "text": "Mika评测-{run}-联系人"
    }
  ],
  "maxSteps": 30,
  "timeoutSec": 420,
  "marker": "Mika评测-{run}-联系人",
  "note": "手机自带的 App 不钉包名,跑的时候按安卓标准 Intent 找这台手机上的"
}
