{
  "id": "alarm-workday-train",
  "goal": "在手机自带的时钟里新建一个工作日 7:20 响的闹钟,闹钟名称写「Mika评测-{run}-工作日甲」",
  "apps": [
    "{app:alarm}"
  ],
  "category": "write",
  "partition": "holdout",
  "requires": [
    "app:alarm"
  ],
  "expect": "succeeded",
  "checks": [
    {
      "type": "screen_has",
      "packageName": "{app:alarm}",
      "text": "Mika评测-{run}-工作日甲"
    }
  ],
  "maxSteps": 30,
  "timeoutSec": 420,
  "marker": "Mika评测-{run}-工作日甲",
  "note": "手机自带的 App 不钉包名,跑的时候按安卓标准 Intent 找这台手机上的",
  "split": "train"
}