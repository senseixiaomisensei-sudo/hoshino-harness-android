{
  "id": "alarm-once-train",
  "goal": "在手机自带的时钟里新建一个 6:40 的闹钟,只响一次,闹钟名称写「Mika评测-{run}-闹钟甲」",
  "apps": [
    "{app:alarm}"
  ],
  "category": "write",
  "partition": "tune",
  "requires": [
    "app:alarm"
  ],
  "expect": "succeeded",
  "checks": [
    {
      "type": "screen_has",
      "packageName": "{app:alarm}",
      "text": "Mika评测-{run}-闹钟甲"
    }
  ],
  "maxSteps": 30,
  "timeoutSec": 420,
  "marker": "Mika评测-{run}-闹钟甲",
  "note": "手机自带的 App 不钉包名,跑的时候按安卓标准 Intent 找这台手机上的",
  "split": "train"
}