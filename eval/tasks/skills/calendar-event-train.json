{
  "id": "calendar-event-train",
  "goal": "在手机自带的日历里新建一个明天 10:00 到 10:30 的日程,标题写「Mika评测-{run}-日程甲」,不要邀请任何人",
  "apps": [
    "{app:calendar}"
  ],
  "category": "write",
  "partition": "tune",
  "requires": [
    "app:calendar"
  ],
  "expect": "succeeded",
  "checks": [
    {
      "type": "screen_has",
      "packageName": "{app:calendar}",
      "text": "Mika评测-{run}-日程甲"
    }
  ],
  "maxSteps": 30,
  "timeoutSec": 420,
  "marker": "Mika评测-{run}-日程甲",
  "note": "手机自带的 App 不钉包名,跑的时候按安卓标准 Intent 找这台手机上的",
  "split": "train"
}